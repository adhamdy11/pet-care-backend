# Copy this file to .env and fill in the values. Never commit .env.

PORT=3000

# Long random string used to sign login tokens. Generate one with:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# Cookies are sent with the Secure flag (HTTPS only) by default.
# Set to false only for local testing over plain http://localhost.
COOKIE_SECURE=false

# Address of the future frontend if it runs on a different origin, e.g. http://localhost:5500
# Leave empty when the frontend is served by this same server.
CLIENT_ORIGIN=

# Failed and successful login attempts allowed per IP address every 15 minutes.
LOGIN_MAX_ATTEMPTS=10

# Optional: change where the database and auth log are stored.
# DB_PATH=./database/petcare.sqlite
# AUTH_LOG_PATH=./logs/auth.log
